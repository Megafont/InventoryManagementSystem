@page "/account/manageusers"

@using IMS.WebApp.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

<!--You can put multiple instances of the Authorize attribute to require more than one policy on this page.-->
@attribute [Authorize(Policy = "UserAdmin")]

@inject UserManager<ApplicationUser> UserManager

<h3>Manage Users</h3>
<br />

@if (users is not null && users.Count > 0)
{
    <table class="table">
        <thead>
            <th>Username</th>
            <th>Email</th>
        </thead>
        <tbody>
            @foreach (ApplicationUser user in users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td><a href="/account/manageuser/@user.Id" class="btn btn-link">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code 
{
    // ApplicationUser is our user class, which inherits from IdentityUser.
    // We're using the PersistentState attribute to ensure the users list is not loaded more than once.
    [PersistentState]
    public List<ApplicationUser>? users { get; set; }


    protected override void OnInitialized()
    {
        base.OnInitialized();

        // If the users list is null, then load it.
        users ??= UserManager.Users.ToList();
    }
}
