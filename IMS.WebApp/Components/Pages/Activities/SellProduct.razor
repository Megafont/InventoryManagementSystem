@page "/sellproduct"

@using IMS.UseCases.PluginInterfaces
@using static IMS.WebApp.Components.Controls.Common.AutoCompleteComponent;

<!--Makes this page require being logged in.-->
<!--You can put multiple instances of the Authorize attribute to require more than one policy on this page.-->
@attribute [Authorize(Policy = "Sales")]

@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

@inject IGetProductsByNameUseCase GetProductsByNameUseCase
@inject IGetProductByIdUseCase GetProductByIdUseCase
@inject ISellProductUseCase SellProductUseCase

@inject IProductTransactionRepository ProductTransactionRepository

<h3>Sell Product</h3>
<br />

<EditForm id="sell-form" EditContext="_editContext" OnValidSubmit="Sell">
    <DataAnnotationsValidator />
    <ValidationSummary />
    @if (_checkingSalesOrderNumber) { <span>Checking...</span> }

    <div class="form-group">
        <label for="po">Sales Order #</label>
        <InputText id="po"
                   class="form-control"
                   @bind-Value="_sellProductViewModel.SalesOrderNumber" />
    </div>

    <br />

    <div class="card">
        <div class="card=body">
            <div class="form-group">
                <AutoCompleteComponent Label="Product to Sell"
                                       SearchFunction="SearchProduct"
                                       OnItemSelected="OnItemSelected" />
            </div>
        </div>
    </div>

    <br />

    <div class="form-group">
        <label for="qty">Quantity</label>
        <InputNumber id="qty"
                     class="form-control"
                     @bind-Value="_sellProductViewModel.QuantityToSell" />
    </div>
    
    <br />

    <div class="form-group">
        <label for="price">Unit Price</label>
        <InputNumber id="price"
                     class="form-control"
                     @bind-Value="_sellProductViewModel.UnitPrice" />
    </div>

    <br />

    <button type="submit"
            class="btn btn-primary">
        Sell
    </button>

</EditForm>

@code
{
    private SellProductViewModel _sellProductViewModel = new();
    private Product? _selectedProduct;

    private AuthenticationState? _authenticationState;

    private EditContext _editContext = default!;
    private ValidationMessageStore _extraValidationMessages = default!;
    private bool _checkingSalesOrderNumber;


    protected override async Task OnInitializedAsync()
    {
        _authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        _editContext = new(_sellProductViewModel);
        _extraValidationMessages = new(_editContext);
        _editContext.OnFieldChanged += (_, _) => _extraValidationMessages.Clear();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            // Call the preventFormSubmission() function in our javascript file (JS_Interop.js in the wwwroot folder).
            // This script prevents the Enter key from submitting the form like it does by default.
            // The first parameter here is the name of the Javascript function to call, and the second is the ID of
            // the form we want to ignore the Enter key rather than submitting.
            // NOTE: For this to work, our javascript file needs to be included in app.razor as well.
            JSRuntime.InvokeVoidAsync("preventFormSubmission", "sell-form");

            // .NET 10 also added a couple new functions as you can see below.
            // NOTE that this function has to be changed to be an async function in order to use await here.
            //string url = await JSRuntime.GetValueAsync<string>("document.location.href");
            //JSRuntime.SetValueAsync("document.title", $"Purchase Inventory ({url})");
            // These two function allow you to get and set values of properties in the DOM (document object model)
            // in the browser, which is its internal representation of the page.

            // .NET 10 also added a function to create a javascript object. The first parameter is the name of the javascript
            // class we want to create an instance of. This Car class is also defined in JS_Interop.js.
            // The rest of the parameters are the values expected by the car class' constructor (make, model, and year).
            //var myCar = await JSRuntime.InvokeConstructorAsync("Car", "Chevy", "Camaro", 2025);
            // The following line calls the car class' getDescription(function);
            //string description = await myCar.InvokeAsync<string>("getDescription");
            // And here we use GetValueAsync() to get the value of one of Car's properties:
            //string make = await myCar.GetValueAsync<string>("make");
        }
    }

    private async Task<List<ItemViewModel>?> SearchProduct(string searchFilter)
    {
        var list = await GetProductsByNameUseCase.ExecuteAsync(searchFilter);
        if (list is null)
            return null;

        // This is called projection. We are projecting the list of found products from type IEnumerable<Product> to type List<ItemViewModel>.
        // This is a common pattern in C# when you want to transform a collection of one type into a collection of another type.
        return list.Select(x => new ItemViewModel() { ID = x.ProductID, Name = x.ProductName })?.ToList();
    }

    private async Task OnItemSelected(ItemViewModel item)
    {
        _selectedProduct = await GetProductByIdUseCase.ExecuteAsync(item.ID);

        _sellProductViewModel.ProductID = item.ID;
        _sellProductViewModel.Product = _selectedProduct;
        _sellProductViewModel.UnitPrice = _selectedProduct.Price;
    }

    private async Task Sell()
    {
        string userName = string.Empty;

        if (_authenticationState?.User?.Identity?.IsAuthenticated ?? false)
        {
            userName = _authenticationState.User.Identity.Name ?? string.Empty;

            _checkingSalesOrderNumber = true;
            if (await IsSalesOrderNumberAvailable(_sellProductViewModel.SalesOrderNumber))
            {
                await SellProductUseCase.ExecuteAsync(
                    _sellProductViewModel.SalesOrderNumber,
                    _selectedProduct,
                    _sellProductViewModel.QuantityToSell,
                    _sellProductViewModel.UnitPrice,
                    userName
                );

                // Create a new SellProductViewModel. This causes the UI to be cleared since this variable now has all empty fields.
                _sellProductViewModel = new();

                // Re-create the EditContext and ValidationMessageStore so they are bound to the new view model instance.
                _editContext = new(_sellProductViewModel);
                _extraValidationMessages = new(_editContext);
                _editContext.OnFieldChanged += (_, _) => _extraValidationMessages.Clear();

                _selectedProduct = null;
            }
        }
    }

    /// <summary>
    /// Checks the sales order number is available.
    /// </summary>
    /// <remarks>>
    /// This validation is handled this way rather than using a validation attribute like we did for stuff like ensuring there is enough inventory quantity to produce a product.
    /// That is because this validation needs to access the database, which means it has to be async. Validation attributes cannot be async, so I did this instead after some Google searching.
    /// </remarks>
    /// <param name="salesOrderNumber">The sales order number to check.</param>
    /// <returns>True if it's available and false otherwise.</returns>
    private async Task<bool> IsSalesOrderNumberAvailable(string salesOrderNumber)
    {
        ProductTransaction? transaction = await ProductTransactionRepository.GetProductTransactionBySalesOrderNumberAsync(salesOrderNumber);
        _checkingSalesOrderNumber = false;


        if (transaction != null)
        {
            _extraValidationMessages.Add(() => _sellProductViewModel.SalesOrderNumber!,
                $"The sales order # ({_sellProductViewModel.SalesOrderNumber}) is already in use by another product transaction in the database!");
            _editContext.NotifyValidationStateChanged();

            return false;
        }

        return true;
    }
}
